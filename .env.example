# Create a bot with @BotFather, then paste its token here.
TELEGRAM_BOT_TOKEN=

# The private forum-group ID (recommended), or your private-chat ID.
TELEGRAM_CHAT_ID=

# Your numeric Telegram user ID. Only this sender can invoke Codex.
TELEGRAM_USER_ID=
# Maximum attachment size sent through the Bot API (hard limit: 50 MB).
TELEGRAM_MAX_FILE_MB=45
# Abort one stalled upload after this many seconds, then retry according to the setting below.
TELEGRAM_UPLOAD_TIMEOUT_SECONDS=60
TELEGRAM_UPLOAD_RETRIES=1

# Default folder for topics not explicitly bound to a project.
CODEX_WORKSPACE=.

# Least privilege is the default. Allowed: read-only, workspace-write, danger-full-access.
CODEX_SANDBOX=read-only
CODEX_COMMAND=codex
# Optional JSON array inserted before `exec`, useful for `node /path/to/codex.js`.
CODEX_COMMAND_ARGS_JSON=[]
# Optional CLI-compatible model; empty uses the CLI's advertised default.
CODEX_MODEL=
# Set true only when CODEX_WORKSPACE is an intentional non-Git parent directory.
CODEX_SKIP_GIT_REPO_CHECK=false
# Codex turn timeout in seconds. Set to 0 to disable the bridge-level timeout.
CODEX_TIMEOUT_SECONDS=1800
# Different Telegram topics may run concurrently; one topic still runs one turn at a time.
CODEX_MAX_CONCURRENT_TURNS=2
# Stop an idle topic App Server after this many seconds. Set to 0 to keep it alive.
CODEX_RUNNER_IDLE_SECONDS=300

# Loopback API shared by the relay and MCP process.
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=43921
BRIDGE_TOKEN=replace-with-a-long-random-value

# Runtime data stays local and is ignored by Git.
STATE_FILE=.data/state.json
RELAY_LOG_FILE=.data/relay.log
LOG_LEVEL=info
